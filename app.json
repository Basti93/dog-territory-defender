{
  "expo": {
    "name": "Dog Territory Defender",
    "slug": "dog-territory-defender",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dogtd.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.dogtd.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2ECC71"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermissions": "Allow Dog Territory Defender to track your walks",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAFAF8",
          "resizeMode": "contain",
          "imageWidth": 300
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2ECC71"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4a01eaa-082d-4dfc-9ece-4d5004d5689b"
      }
    },
    "userInterfaceStyle": "light",
    "orientation": "portrait"
  }
}
