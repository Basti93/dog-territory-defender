{
  "expo": {
    "name": "Tails Up",
    "slug": "dog-territory-defender",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dogtd.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "B5PP3ZZRM2"
    },
    "android": {
      "package": "com.dogtd.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2ECC71"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushCapability.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermissions": "Allow Tails Up to track your walks",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAFAF8",
          "resizeMode": "contain",
          "imageWidth": 300
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2ECC71"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4a01eaa-082d-4dfc-9ece-4d5004d5689b"
      }
    },
    "userInterfaceStyle": "light",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f4a01eaa-082d-4dfc-9ece-4d5004d5689b",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
