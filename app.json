{
  "expo": {
    "name": "Dog Territory Defender",
    "slug": "dog-territory-defender",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dogtd.mobile"
    },
    "android": {
      "package": "com.dogtd.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermissions": "Allow Dog Territory Defender to track your walks"
        }
      ],
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "f4a01eaa-082d-4dfc-9ece-4d5004d5689b"
      }
    }
  }
}
