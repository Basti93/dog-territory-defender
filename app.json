{
  "expo": {
    "name": "Tails Up",
    "slug": "dog-territory-defender",
    "version": "0.3.0",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dogtd.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "B5PP3ZZRM2"
    },
    "android": {
      "package": "com.dogtd.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2ECC71"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushCapability.js",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Tails Up follows your walk with Buddy, even while your screen is off, so every street you walk gets claimed.",
          "locationAlwaysPermission": "Tails Up follows your walk with Buddy, even while your screen is off, so every street you walk gets claimed.",
          "locationWhenInUsePermission": "Tails Up shows you and Buddy on the map while you walk."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAFAF8",
          "resizeMode": "contain",
          "imageWidth": 300
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2ECC71"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tails Up darf die Kamera benutzen, damit du ein Foto von deinem Hund machen kannst. Das Foto wird nicht gespeichert. / Tails Up can use the camera so you can take a photo of your dog. The photo is not stored.",
          "photosPermission": "Tails Up darf auf deine Fotos zugreifen, damit du Bilder von deinem Hund auswählen kannst. / Tails Up can read your photos so you can pick pictures of your dog.",
          "microphonePermission": false
        }
      ],
      "expo-image-manipulator",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4a01eaa-082d-4dfc-9ece-4d5004d5689b"
      }
    },
    "userInterfaceStyle": "light",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f4a01eaa-082d-4dfc-9ece-4d5004d5689b",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
