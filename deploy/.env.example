# Kopieren nach .env, `chmod 600 .env`, Werte setzen. .env ist git-ignoriert. Nie committen oder in den Chat.
# Passwort nur aus URL-sicheren Zeichen (A-Z a-z 0-9 - _), z. B. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Muss dasselbe Passwort enthalten (Host `db`, Port 5432 innerhalb des Compose-Netzes).
# DATABASE_URL wird aus POSTGRES_PASSWORD abgeleitet; nur fuer eine externe/Cloud-DB setzen:
# DATABASE_URL=postgres://user:pass@host:5432/dtd
# Tailscale-Admin-Konsole: Auth-Key (nicht wiederverwendbar). Funnel + HTTPS-Zertifikate muessen fuer den Knoten erlaubt sein.
TS_AUTHKEY=

API_LOG_LEVEL=info
HOUSEHOLD_MAX_PLAYERS=4
# Nach dem ersten Start pruefen: kommt eine brauchbare X-Forwarded-For-Adresse an? (design.md Decision 16)
TRUST_PROXY_CIDR=172.16.0.0/12
LOG_FORWARDED_HEADERS=false
# Aeltere App-Staende abweisen (426 bei Schreibzugriffen): erst anheben, wenn beide Telefone das Update haben.
MIN_CLIENT_API_LEVEL=1
# Track B (Nachbarhunde): an seit M3 (App zeigt Zettel, Flicken, Geschenke). false = Kill-Switch.
NEIGHBOURS_ENABLED=true
OVERPASS_URL=
# Hundefoto-Analyse ueber den bestehenden LiteLLM-Proxy (Modell-Alias DTD_VISION_MODEL, z. B. small = Claude Haiku). Leerer Key = Funktion aus (App zeigt nur die manuelle Auswahl).
# Der Proxy liegt in einem anderen Compose-Netz: die Zeile COMPOSE_FILE haengt docker-compose.litellm.yml an (haengt api in dieses Netz,
# Name via LITELLM_NETWORK). Ohne diese Zeile startet alles wie bisher, auch wenn das Netz nicht existiert.
# COMPOSE_FILE=docker-compose.yml:docker-compose.litellm.yml
# LITELLM_NETWORK=litellm-stack_default
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
DTD_VISION_MODEL=small
# Eigene Sicherheitsgrenze pro Kalendermonat (UTC), aus Token-Nutzung (0,75/3,75 USD je Mio. Token), sonst 0,005 USD je Analyse; danach 429 analysis_limit.
GEMINI_MONTHLY_CAP_USD=10
