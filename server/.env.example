# Copy to .env (never commit). All configuration is env-only.
DATABASE_URL=postgres://dtd:change-me@db:5432/dtd
PORT=7000
# Internal readiness listener (/readyz). Do not publish this port. 0 disables it.
READY_PORT=7100
LOG_LEVEL=info
HOUSEHOLD_MAX_PLAYERS=4
# Networks whose X-Forwarded-For is trusted (the Tailscale sidecar's compose network); never IP-banned.
TRUST_PROXY_CIDR=172.16.0.0/12
LOG_FORWARDED_HEADERS=false
# Apply drizzle migrations at start (single API instance). Otherwise run: node dist/ops/migrate.js
MIGRATE_ON_START=false
# Track B: Nachbarhunde (simulated neighbour dogs). Keep false until the app side has landed.
# true = bots are created on a household's first tracked walk, the scheduler runs in the api process.
NEIGHBOURS_ENABLED=false
# Overpass interpreter for street tiles, e.g. https://overpass-api.de/api/interpreter (a mirror works too).
# Empty = never fetch; walks are generated by the offset fallback (jittered copies of the household's own routes).
OVERPASS_URL=
# Pause between sequential Overpass tile fetches (ms).
OVERPASS_PAUSE_MS=2000
