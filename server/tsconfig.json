{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@game/*": ["../src/*"]
    }
  },
  "include": ["src", "test", "scripts", "*.ts", "../src/sync/apiContract.ts"]
}
