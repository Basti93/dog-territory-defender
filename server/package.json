{
  "name": "dog-territory-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Dog Territory Defender household sync API (Fastify + Postgres + Drizzle)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "migrate": "tsx src/ops/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "cli": "tsx src/ops/cli.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
